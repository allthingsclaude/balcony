#!/bin/bash
# Balcony Hook Handler — bidirectional for PermissionRequest
# Set BALCONY_HOOK_DEBUG=1 to enable debug logging to /tmp/balcony-hook-debug.log

SOCKET_PATH="$HOME/.balcony/hooks.sock"
DEBUG_LOG="/tmp/balcony-hook-debug.log"

debug() {
    [ -n "$BALCONY_HOOK_DEBUG" ] || return 0
    echo "[$(date '+%H:%M:%S')] hook-handler: $1" >> "$DEBUG_LOG"
}

# Check if the socket exists
if [ ! -S "$SOCKET_PATH" ]; then
    debug "No socket at $SOCKET_PATH"
    exit 0
fi

# Read all stdin
INPUT=$(cat)

# Inject BALCONY_PTY_SESSION_ID into JSON if available (set by balcony CLI wrapper)
if [ -n "$BALCONY_PTY_SESSION_ID" ]; then
    INPUT=$(echo "$INPUT" | python3 -c "
import json, sys, os
try:
    d = json.loads(sys.stdin.read())
    d['balcony_pty_session_id'] = os.environ['BALCONY_PTY_SESSION_ID']
    print(json.dumps(d))
except:
    pass
" 2>/dev/null || echo "$INPUT")
fi

if [ -z "$INPUT" ]; then
    debug "Empty stdin"
    exit 0
fi

# Parse event type
EVENT_INFO=$(echo "$INPUT" | python3 -c "
import json, sys
try:
    d = json.loads(sys.stdin.read())
    name = d.get('hook_event_name', 'unknown')
    ntype = d.get('notification_type', '')
    has_msg = 'yes' if d.get('last_assistant_message') else 'no'
    print(f'{name}|{ntype}|{has_msg}')
except:
    print('unknown||no')
" 2>/dev/null)

EVENT_NAME=$(echo "$EVENT_INFO" | cut -d'|' -f1)
NOTIF_TYPE=$(echo "$EVENT_INFO" | cut -d'|' -f2)
HAS_MSG=$(echo "$EVENT_INFO" | cut -d'|' -f3)

IS_PERMISSION="no"
[ "$EVENT_NAME" = "PermissionRequest" ] && IS_PERMISSION="yes"

debug "Event: name=$EVENT_NAME notif_type=$NOTIF_TYPE has_last_msg=$HAS_MSG is_permission=$IS_PERMISSION"

if [ "$IS_PERMISSION" = "yes" ]; then
    debug "PermissionRequest: sending event and waiting for response..."

    # PermissionRequest: send event, wait for response, output to stdout
    RESPONSE=$(echo "$INPUT" | python3 -c "
import socket, sys, os

def dbg(msg):
    if os.environ.get('BALCONY_HOOK_DEBUG'):
        with open('/tmp/balcony-hook-debug.log', 'a') as f:
            f.write('[python] ' + msg + '\n')

data = sys.stdin.buffer.read()
if not data:
    sys.exit(0)

dbg(f'Sending {len(data)} bytes to socket')

s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
try:
    s.connect(os.path.expanduser('~/.balcony/hooks.sock'))
    s.sendall(data)
    dbg('Data sent, shutting down write side')

    # Signal end of request
    s.shutdown(socket.SHUT_WR)

    dbg('Waiting for response...')

    # Wait indefinitely — Claude Code is blocked until the user responds
    s.settimeout(None)
    response = b''
    while True:
        try:
            chunk = s.recv(4096)
            if not chunk:
                break
            response += chunk
        except socket.timeout:
            dbg('Timeout waiting for response')
            break

    dbg(f'Got response: {response}')

    if response:
        # Output to stdout for Claude Code
        sys.stdout.buffer.write(response)
        sys.stdout.buffer.flush()
except Exception as e:
    dbg(f'Error: {e}')
finally:
    s.close()
" 2>/dev/null)

    debug "Response from python: '$RESPONSE'"
    if [ -n "$RESPONSE" ]; then
        debug "Outputting response to stdout"
        # Output the response JSON to stdout for Claude Code to read
        printf '%s' "$RESPONSE"
    else
        debug "No response received"
    fi
else
    debug "Non-permission event ($EVENT_NAME), fire and forget"
    # Other events: fire and forget
    echo "$INPUT" | python3 -c "
import socket, sys, os

def dbg(msg):
    if os.environ.get('BALCONY_HOOK_DEBUG'):
        with open('/tmp/balcony-hook-debug.log', 'a') as f:
            f.write('[python] ' + msg + '\n')

data = sys.stdin.buffer.read()
if data:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(os.path.expanduser('~/.balcony/hooks.sock'))
        s.sendall(data)
        s.shutdown(socket.SHUT_WR)
        dbg(f'fire-and-forget: sent {len(data)} bytes OK')
    except Exception as e:
        dbg(f'fire-and-forget ERROR: {e}')
else:
    dbg('fire-and-forget: no data to send')
" 2>/dev/null
fi
